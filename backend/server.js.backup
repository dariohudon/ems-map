require('dotenv').config();
const express = require('express');
const axios = require('axios');
const cron = require('node-cron');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(cors());
app.use(express.json());

const DATA_DIR = path.join(__dirname, 'data');
const CALGARY_API = process.env.CALGARY_API_BASE;

// ─── Helper: fetch from Calgary Open Data ────────────────────────────────────
async function fetchCalgaryData(datasetId, queryString = '') {
  const url = `${CALGARY_API}/${datasetId}.json?$limit=5000${queryString}`;
  const response = await axios.get(url);
  return response.data;
}

// ─── Helper: cache data to disk ─────────────────────────────────────────────
function cacheData(filename, data) {
  fs.writeFileSync(path.join(DATA_DIR, filename), JSON.stringify(data));
}

function loadCache(filename) {
  const filepath = path.join(DATA_DIR, filename);
  if (fs.existsSync(filepath)) {
    return JSON.parse(fs.readFileSync(filepath, 'utf8'));
  }
  return null;
}


// ─── Data refresh function ────────────────────────────────────────────────────
async function refreshData() {
  console.log(`[${new Date().toISOString()}] Refreshing data...`);
  try {
    const stations = await fetchCalgaryData('s6f4-ijrf');
    cacheData('stations.json', stations);
    console.log(`  ✓ EMS Stations: ${stations.length} records`);

    const calls = await fetchCalgaryData('d6us-rmnf', '&$order=date+DESC');
    cacheData('calls.json', calls);
    console.log(`  ✓ Response Calls: ${calls.length} records`);

  } catch (err) {
    console.error('Data refresh error:', err.message);
  }
}


// ─── API Routes ──────────────────────────────────────────────────────────────

// GET /api/stations — EMS station locations
app.get('/stations', (req, res) => {
  const data = loadCache('stations.json');
  if (!data) return res.status(503).json({ error: 'Data not yet loaded' });
  res.json(data);
});

// GET /api/calls — historical response call data
app.get('/calls', (req, res) => {
  const data = loadCache('calls.json');
  if (!data) return res.status(503).json({ error: 'Data not yet loaded' });
  res.json(data);
});

// GET /api/stats — aggregated statistics
app.get('/stats', (req, res) => {
  const calls = loadCache('calls.json');
  if (!calls) return res.status(503).json({ error: 'Data not yet loaded' });

  // Call volume by hour of day
  const byHour = Array(24).fill(0);
  // Call volume by day of week
  const byDay = Array(7).fill(0);
  const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

calls.forEach(call => {
    if (call.date) {
      const date = new Date(call.date);
      const count = parseInt(call.incident_count) || 1;
      byHour[date.getHours()] += count;
      byDay[date.getDay()] += count;
    }
  });

  res.json({
    totalCalls: calls.reduce((sum, c) => sum + (parseInt(c.incident_count) || 0), 0),
    byHour: byHour.map((count, hour) => ({ hour, count })),
    byDay: byDay.map((count, day) => ({ day: dayNames[day], count }))
  });
});

// GET /api/health — health check
app.get('/health', (req, res) => {
  res.json({ status: 'ok', timestamp: new Date().toISOString() });
});

// ─── Scheduled refresh (every 6 hours) ──────────────────────────────────────
cron.schedule('0 */6 * * *', refreshData);

// ─── Start server ────────────────────────────────────────────────────────────
app.listen(process.env.PORT, async () => {
  console.log(`EMS Map API running on port ${process.env.PORT}`);
  await refreshData(); // Initial load on startup
});
