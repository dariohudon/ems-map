// ─── Configuration ───────────────────────────────────────────────────────────
const API_BASE = '/api';
const CALGARY_CENTER = [51.0447, -114.0719];
const ZOOM_LEVEL = 11;

// ─── Initialize Map ───────────────────────────────────────────────────────────
const map = L.map('map').setView(CALGARY_CENTER, ZOOM_LEVEL);

L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
  subdomains: 'abcd',
  maxZoom: 19
}).addTo(map);

// ─── Layer Groups ─────────────────────────────────────────────────────────────
const emsLayer = L.layerGroup().addTo(map);
const fireLayer = L.layerGroup().addTo(map);
const sharedLayer = L.layerGroup().addTo(map);

// ─── Icons ────────────────────────────────────────────────────────────────────
function makeIcon(color, size, glow) {
  var s = size || 14;
  return L.divIcon({
    className: '',
    html: '<div style="background:' + color + ';border:2px solid #fff;border-radius:50%;width:' + s + 'px;height:' + s + 'px;box-shadow:0 0 6px ' + (glow || color) + ';"></div>',
    iconSize: [s, s],
    iconAnchor: [s/2, s/2]
  });
}

function makeStarIcon(color) {
  return L.divIcon({
    className: '',
    html: '<div style="background:' + color + ';border:2px solid #fff;width:18px;height:18px;transform:rotate(45deg);box-shadow:0 0 8px ' + color + ';"></div>',
    iconSize: [18, 18],
    iconAnchor: [9, 9]
  });
}

var emsIcon    = makeIcon('#e63946', 14, 'rgba(230,57,70,0.8)');
var fireIcon   = makeIcon('#4da6ff', 14, 'rgba(77,166,255,0.8)');
var sharedIcon = makeIcon('#c77dff', 16, 'rgba(199,125,255,0.9)');
var hqIcon     = makeStarIcon('#ffd166');

// ─── Helper: get coords ───────────────────────────────────────────────────────
function getCoords(s) {
  if (s.latitude && s.longitude) {
    return [parseFloat(s.latitude), parseFloat(s.longitude)];
  }
  if (s.point) {
    var coords = typeof s.point === 'string' ? JSON.parse(s.point) : s.point;
    return [coords.coordinates[1], coords.coordinates[0]];
  }
  return null;
}

// ─── Chart instances (so we can destroy/recreate on tab switch) ───────────────
var chartMonth = null;
var chartDay = null;
var chartType = null;

// ─── Load Stations ────────────────────────────────────────────────────────────
async function loadStations() {
  var res = await fetch(API_BASE + '/stations');
  var stations = await res.json();
  emsLayer.clearLayers();
  sharedLayer.clearLayers();

  stations.forEach(function(s) {
    var coords = getCoords(s);
    if (!coords) return;
    var name = s.name || 'EMS Station';
    var address = s.address || '';
    var shared = s.collocated === true;
    var icon = shared ? sharedIcon : emsIcon;
    var color = shared ? '#c77dff' : '#e63946';
    var type = shared ? 'EMS + Fire (Shared)' : 'EMS Station';
    var layer = shared ? sharedLayer : emsLayer;

    L.marker(coords, { icon: icon })
      .bindPopup('<div style="font-family:sans-serif;min-width:180px;"><strong style="color:' + color + ';">🚑 ' + name + '</strong><br><small style="color:#aaa;">' + type + '</small><br>' + (address ? '<small>' + address + '</small>' : '') + '</div>')
      .addTo(layer);
  });

  document.getElementById('stat-ems').textContent = stations.length;
}

async function loadFireStations() {
  var res = await fetch(API_BASE + '/fire-stations');
  var stations = await res.json();
  fireLayer.clearLayers();

  stations.forEach(function(s) {
    var coords = getCoords(s);
    if (!coords) return;
    var name = s.name || 'Fire Station';
    var address = s.address || '';
    var isHQ = name.indexOf('HQ') !== -1;
    var shared = s.collocated === true;
    if (shared) return;

    var icon = isHQ ? hqIcon : fireIcon;
    var color = isHQ ? '#ffd166' : '#4da6ff';
    var type = isHQ ? 'Fire HQ' : 'Fire Station';

    L.marker(coords, { icon: icon })
      .bindPopup('<div style="font-family:sans-serif;min-width:180px;"><strong style="color:' + color + ';">🚒 ' + name + '</strong><br><small style="color:#aaa;">' + type + '</small><br>' + (address ? '<small>' + address + '</small>' : '') + '</div>')
      .addTo(fireLayer);
  });

  document.getElementById('stat-fire').textContent = stations.length;
}

// ─── Charts ───────────────────────────────────────────────────────────────────
var chartOptions = {
  responsive: true,
  plugins: { legend: { display: false } },
  scales: {
    x: { ticks: { color: '#888', font: { size: 10 } }, grid: { color: '#2a2d3a' } },
    y: { ticks: { color: '#888', font: { size: 10 } }, grid: { color: '#2a2d3a' } }
  }
};

var typeColors = {
  'Medical/Rescue': '#e63946',
  'Fire': '#ff6b35',
  'False Alarm': '#4da6ff',
  'Investigation': '#888',
  'Public Service Assistance': '#c77dff',
  'Hazardous Condition': '#ffd166',
  'Severe Weather': '#06d6a0',
  'Rupture/Explosion': '#ff006e'
};

function renderCharts(stats) {
  if (chartMonth) chartMonth.destroy();
  if (chartDay) chartDay.destroy();
  if (chartType) chartType.destroy();

  chartMonth = new Chart(document.getElementById('chart-month'), {
    type: 'bar',
    options: chartOptions,
    data: {
      labels: stats.byMonth.map(function(m) { return m.month; }),
      datasets: [{ data: stats.byMonth.map(function(m) { return m.count; }), backgroundColor: '#4da6ff88', borderColor: '#4da6ff', borderWidth: 1 }]
    }
  });

  chartDay = new Chart(document.getElementById('chart-day'), {
    type: 'bar',
    options: chartOptions,
    data: {
      labels: stats.byDay.map(function(d) { return d.day; }),
      datasets: [{ data: stats.byDay.map(function(d) { return d.count; }), backgroundColor: '#e6394688', borderColor: '#e63946', borderWidth: 1 }]
    }
  });

  chartType = new Chart(document.getElementById('chart-type'), {
    type: 'doughnut',
    options: {
      responsive: true,
      plugins: {
        legend: { display: true, position: 'bottom', labels: { color: '#aaa', font: { size: 10 }, boxWidth: 12 } }
      }
    },
    data: {
      labels: stats.byType.map(function(t) { return t.type; }),
      datasets: [{
        data: stats.byType.map(function(t) { return t.count; }),
        backgroundColor: stats.byType.map(function(t) { return typeColors[t.type] || '#555'; }),
        borderColor: '#1a1d27',
        borderWidth: 2
      }]
    }
  });
}

// ─── Load Stats with optional year ───────────────────────────────────────────
var availableYears = [];

async function loadStats(year) {
  var url = API_BASE + '/stats';
  if (year) url += '?year=' + year;
  var res = await fetch(url);
  var stats = await res.json();

  // Build year tabs on first load
  if (stats.years && availableYears.length === 0) {
    availableYears = stats.years;
    buildYearTabs(stats.years);
  }

  var label = year ? year : 'All Years';
  document.getElementById('stat-total').textContent = stats.totalCalls.toLocaleString();
  document.getElementById('stat-year-label').textContent = label;
  renderCharts(stats);
}

// ─── Build Year Tabs ──────────────────────────────────────────────────────────
function buildYearTabs(years) {
  var container = document.getElementById('year-tabs');
  container.innerHTML = '';

  // ALL tab
  var allTab = document.createElement('button');
  allTab.className = 'year-tab active';
  allTab.textContent = 'All';
  allTab.addEventListener('click', function() {
    setActiveTab(allTab);
    loadStats(null);
  });
  container.appendChild(allTab);

  // Year tabs
  years.forEach(function(y) {
    var btn = document.createElement('button');
    btn.className = 'year-tab';
    btn.textContent = y;
    btn.addEventListener('click', function() {
      setActiveTab(btn);
      loadStats(y);
    });
    container.appendChild(btn);
  });
}

function setActiveTab(activeBtn) {
  document.querySelectorAll('.year-tab').forEach(function(btn) {
    btn.classList.remove('active');
  });
  activeBtn.classList.add('active');
}

// ─── Layer Toggle Controls ────────────────────────────────────────────────────
document.getElementById('toggle-ems').addEventListener('change', function(e) {
  if (e.target.checked) emsLayer.addTo(map); else map.removeLayer(emsLayer);
});
document.getElementById('toggle-fire').addEventListener('change', function(e) {
  if (e.target.checked) fireLayer.addTo(map); else map.removeLayer(fireLayer);
});
document.getElementById('toggle-shared').addEventListener('change', function(e) {
  if (e.target.checked) sharedLayer.addTo(map); else map.removeLayer(sharedLayer);
});

// ─── Initialize ───────────────────────────────────────────────────────────────
async function init() {
  document.getElementById('last-updated').textContent = 'Loading...';
  await Promise.all([loadStations(), loadFireStations(), loadStats(null)]);
  document.getElementById('last-updated').textContent = 'Updated: ' + new Date().toLocaleString();
}

init();
